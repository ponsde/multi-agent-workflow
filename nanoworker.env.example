# nanoworker LLM 凭据示例
#
# 用法：
#   cp nanoworker.env.example ~/.nanoworker/env
#   然后编辑 ~/.nanoworker/env，填入你自己的 key 和 base URL。
#
# 加载顺序（高优先级覆盖低优先级）：
#   1. 进程已有的环境变量（shell export、CI secrets）
#   2. ~/.nanoworker/env
#   3. ~/.nanoworker/config.json 里 providers[].api_key 字面值（已 deprecated）
#
# 这些变量名和 ~/.nanoworker/config.json 里 providers[].api_key_env /
# api_base_env 必须一致。`nanoworker init` 生成的默认配置就用下面这套名字。

# ---- 通用凭据 ----
# 默认配置下 openai 和 anthropic 两个 provider 都从这里取 key。
LLM_API_KEY=replace-me

# ---- OpenAI-compatible base URL ----
# 官方地址：https://api.openai.com/v1
# 自建/代理：填代理地址，例如 https://your-proxy.example.com/v1
LLM_API_BASE=https://api.openai.com/v1

# ---- Anthropic base URL ----
# 只在实际调用 Claude 模型时需要。不用 Claude 就保持注释。
# 官方地址：https://api.anthropic.com
# LLM_ANTHROPIC_API_BASE=https://api.anthropic.com
